# Kopie nach /etc/hosttech-ddns/env, Rechte: chmod 600, Eigentümer root.
# Der Token gehört NUR hierher, niemals ins Repository.

HOSTTECH_TOKEN=ersetzen_durch_api_token
HOSTTECH_DOMAIN=djjessejay.ch

# Record, der aktualisiert wird. "@" = Apex-Domain.
HOSTTECH_RECORD_NAME=@

# Optional: feste IP statt Ermittlung über IP_CHECK_URL.
# HOSTTECH_IP=

# Optional: IPv4-Dienst. Nur IPv4 für A-Records. Eigener Dienst bevorzugt.
IP_CHECK_URL=https://api4.ipify.org

# Optional: HTTP-Timeout in Millisekunden.
HTTP_TIMEOUT_MS=10000

# Optional: 1 = Änderungen nur loggen, nichts schreiben.
DDNS_DRY_RUN=0
